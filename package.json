{
  "name": "generic-record-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "db/migrations"],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "characterize:bounded": "node scripts/characterize-bounded-ingestion.mjs",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "test:package": "node --test tests/package/*.test.mjs",
    "test:examples": "node --test tests/examples/*.test.mjs",
    "example:inventory": "node scripts/run-inventory-example.mjs",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm test && npm run test:integration && npm run test:package && npm run test:examples",
    "test:postgres": "bash ./scripts/run-postgres-integration.sh",
    "db:migrate": "npm run build && node dist/db/migrate.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@types/pg": "^8.0.0"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "pg": "^8.0.0"
  }
}
